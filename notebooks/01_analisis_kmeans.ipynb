   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### 1.6 Detección de outliers (IQR)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def detect_outliers_iqr(series):\n",
    "    Q1 = series.quantile(0.25)\n",
    "    Q3 = series.quantile(0.75)\n",
    "    IQR = Q3 - Q1\n",
    "    lower = Q1 - 1.5 * IQR\n",
    "    upper = Q3 + 1.5 * IQR\n",
    "    return series[(series < lower) | (series > upper)]\n",
    "\n",
    "num_cols = ['Age', 'Annual Income (k$)', 'Spending Score (1-100)']\n",
    "for col in num_cols:\n",
    "    outliers = detect_outliers_iqr(df[col])\n",
    "    print(f\"{col}: {len(outliers)} outliers ({len(outliers)/len(df)*100:.1f}%)\")\n",
    "    if len(outliers) > 0:\n",
    "        print(f\"  Valores: {outliers.values}\")"
   ]
