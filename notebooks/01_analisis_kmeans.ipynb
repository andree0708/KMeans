   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def predecir_cliente(age, income, spending, gender):\n",
    "    \"\"\"Predice cluster para un nuevo cliente\"\"\"\n",
    "    gender_enc = 0 if gender == 'Male' else 1\n",
    "    # Usar solo Income + Spending (modelo 2D)\n",
    "    X_new = scaler.transform([[income, spending]])\n",
    "    cluster = kmeans_final.predict(X_new)[0]\n",
    "    return cluster, business_labels[cluster]\n",
    "\n",
    "# Ejemplos de prueba\n",
    "test_cases = [\n",
    "    (25, 80, 85, 'Female'),   # Joven, alto ingreso, alto gasto → Alto Valor\n",
    "    (35, 20, 75, 'Male'),     # Ingreso bajo, gasto alto → Potencial\n",
    "    (50, 100, 15, 'Female'),  # Ingreso alto, gasto bajo → Bajo Valor (Alto Ingreso)\n",
    "    (40, 55, 50, 'Male'),     # Promedio\n",
    "    (22, 18, 20, 'Female'),   # Bajo en ambos → Bajo Valor\n",
    "]\n",
    "\n",
    "print(\"=== PREDICCIONES DE PRUEBA ===\")\n",
    "for age, inc, spend, gen in test_cases:\n",
    "    cluster, perfil = predecir_cliente(age, inc, spend, gen)\n",
    "    print(f\"Edad:{age}, Income:{inc}k, Spend:{spend}, {gen} → Cluster {cluster}: {perfil}\")"
   ]
